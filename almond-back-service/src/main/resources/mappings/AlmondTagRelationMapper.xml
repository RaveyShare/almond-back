<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ravey.almond.service.dao.mapper.AlmondTagRelationMapper">

    <!-- 插入关联（忽略重复） -->
    <insert id="insertIgnore">
        INSERT IGNORE INTO almond_tag_relation (almond_id, tag_id, create_time)
        VALUES (#{almondId}, #{tagId}, NOW())
    </insert>

    <!-- 删除杏仁的所有标签关联 -->
    <delete id="deleteByAlmondId">
        DELETE FROM almond_tag_relation WHERE almond_id = #{almondId}
    </delete>

</mapper>
